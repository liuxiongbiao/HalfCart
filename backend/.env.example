# ===========================================================
# 半仓智拼 (HalfCart) 后端环境变量模板
# ===========================================================
# 使用方法:
#   cp .env.example .env
#   修改 .env 中的实际配置值
#
# 底座设计 1.6: 所有配置通过环境变量注入
# PRD 5.3: 密钥类配置不以明文写在代码中
# ===========================================================

# ── 应用基础 ─────────────────────────────────
APP_NAME=HalfCart
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── 数据库 MySQL 8.0 (底座设计 1.2) ──────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=halfcart
DB_PASSWORD=halfcart123
DB_NAME=halfcart
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ── Redis 7 (底座设计 1.2) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_CONNECT_TIMEOUT=5

# ── ElasticSearch 8 (底座设计 1.2) ───────────
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=change_me_elasticsearch_password
ES_INDEX_ORDER=order_index
ES_REQUEST_TIMEOUT=10

# ── RabbitMQ 3 (底座设计 1.2) ────────────────
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=halfcart
MQ_PASSWORD=halfcart123
MQ_VHOST=/
MQ_EXCHANGE=halfcart.exchange
MQ_RECONNECT_INTERVAL=5

# ── JWT 双Token (PRD 4.1) ────────────────────
# ⚠️ 生产环境必须替换! 用 `openssl rand -hex 32` 生成
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
# [安全加固] 访问令牌15分钟, 刷新令牌7天 (原PRD 7天/30天已收紧)
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800
JWT_TOKEN_ISSUER=halfcart

# ── AES 手机号加密 (PRD 5.3) ─────────────────
# ⚠️ 生产环境必须替换! 用 `openssl rand -hex 16` 生成32字节随机密钥
# 请勿使用示例值: halfcart-aes-key-32bytes!!!
PHONE_ENCRYPTION_KEY=change-this-to-a-random-32byte-key

# ── 短信服务商 (PRD 4.1) ─────────────────────
SMS_PROVIDER=aliyun
SMS_ENDPOINT=dypnsapi.aliyuncs.com
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=半仓智拼
SMS_TEMPLATE_CODE=100001
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_HOURLY_LIMIT=5

# ── 高德地图 LBS (PRD 4.3) ────────────────────
# Web 服务 API Key (高德控制台 → 应用管理 → Web服务)
# 注意：前端 JS API 需要单独的 Web 端 (JS API) Key
AMAP_WEB_KEY=
AMAP_ENABLE=true
AMAP_MOCK_ENABLED=true
AMAP_COORD_TYPE=gcj02
AMAP_TIMEOUT=3
AMAP_RETRY_TIMES=1
AMAP_CACHE_TTL=86400
AMAP_FRAUD_SPEED_LIMIT=300
AMAP_FRAUD_ACCURACY_THRESHOLD=500
AMAP_RADIUS_LIMIT=1500
AMAP_CIRCUIT_BREAKER_THRESHOLD=10
AMAP_CIRCUIT_BREAKER_COOLDOWN=300

# ── Dify AI 工作流 (PRD 4.7/4.8/4.9) ─────────
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_WORKFLOW_ASR=asr-order-parser
DIFY_WORKFLOW_OCR=ocr-receipt-parser
DIFY_WORKFLOW_DISPUTE=dispute-judge
DIFY_TIMEOUT_SECONDS=30

# ── Mock 支付开关 (PRD 5.4) ──────────────────
# true=MVP阶段Mock支付直通 | false=对接真实支付渠道
MOCK_PAYMENT=true

# ── 业务规则常量 ─────────────────────────────
# LBS搜索半径(km) (PRD 4.3)
LBS_SEARCH_RADIUS_KM=1.5
# LBS缓存TTL(秒) (PRD 4.3 防刷规则)
LBS_CACHE_TTL_SECONDS=10
# 平台服务费率 (PRD 4.5)
PLATFORM_SERVICE_FEE_RATE=0.03
# 核销码连续错误锁定阈值 (PRD 4.5)
VERIFICATION_CODE_LOCK_THRESHOLD=5
# 核销码锁定时间(分钟) (PRD 4.5)
VERIFICATION_CODE_LOCK_MINUTES=10
# 最低提现金额(元) (PRD 4.10)
WITHDRAW_MIN_AMOUNT=10.0
# AI自动裁判最高金额(元) (PRD 4.9)
DISPUTE_AUTO_JUDGE_MAX_AMOUNT=500.0
# AI判责置信度阈值 (PRD 4.9)
DISPUTE_JUDGE_CONFIDENCE_THRESHOLD=0.80
# 聊天记录销毁小时数 (PRD 3.1)
CHAT_CLEANUP_HOURS=24
# 增量对账扫描窗口(小时) (PRD 4.5)
RECONCILE_SCAN_HOURS=24
# 对账间隔(秒) (PRD 4.5)
RECONCILE_CRON_INTERVAL_SECONDS=3600
# 拼单默认截单时间(秒) (PRD 4.2)
ORDER_GATHERING_TIMEOUT_SECONDS=86400
# 现货默认有效期(小时) (PRD 4.8)
SPOT_ORDER_VALID_HOURS=24
# 单张小票最多拆单数 (PRD 4.8)
SPOT_MAX_SPLIT_COUNT=5

# ── 文件上传限制 ─────────────────────────────
# 音频文件最大1MB (PRD 4.7)
MAX_AUDIO_SIZE_BYTES=1048576
# 图片文件最大2MB (PRD 4.8)
MAX_IMAGE_SIZE_BYTES=2097152
# 上传文件保留天数 (PRD 5.3)
UPLOAD_RETENTION_DAYS=7

# ── 限流配置 ─────────────────────────────────
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ORDER_JOIN=10/second
